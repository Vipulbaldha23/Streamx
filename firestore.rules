rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Live streams
    match /streams/{streamId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.streamerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.streamerId == request.auth.uid ||
        // Allow viewers to increment viewer count / likes with rate validation
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'likesCount'])
      );
      allow delete: if isAuthenticated() && (resource.data.streamerId == request.auth.uid || isAdmin());

      // Live chat subcollection
      match /chat/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/streams/$(streamId)).data.streamerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Wallet ledgers & Transactions - Zero Trust Write (Cloud Functions only or Admin)
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Orders created and verified strictly server-side
    }

    // Reports queue
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
